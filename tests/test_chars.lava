// ====== CASOS QUE TU LEXER ACEPTA PERO QUIZÁ NO QUIERES ======
char weird1 = '\n';  // tu regex actual lo acepta como 1 char: backslash + n (2 chars) -> debería caer en BAD_CHAR
char weird2 = '\\';  // igual: 2 chars -> BAD_CHAR